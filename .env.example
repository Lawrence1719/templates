# Local Postgres from docker-compose. Any Postgres works (Supabase, Neon...).
DATABASE_URL=postgres://templates:templates@localhost:5432/templates

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Leave RESEND_API_KEY empty in development: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="Starter <onboarding@resend.dev>"

# File storage. Leave S3_BUCKET empty to store files on disk in FILES_DIR (development).
# Works with AWS S3, Cloudflare R2, Supabase Storage (S3 endpoint) or MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
FILES_DIR=.storage
MAX_FILE_BYTES=10485760

# Scheduled jobs (membership renewals and reminders). Generate with: openssl rand -hex 32
# Call GET /api/cron/memberships with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
